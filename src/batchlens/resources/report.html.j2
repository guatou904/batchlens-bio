<!doctype html>
<html lang="{{ language }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'">
<title>BatchLens · {{ t('Experimental design audit', '实验设计审计') }}</title><style>
:root{color-scheme:light;--ink:#162e36;--muted:#526871;--line:#d6e0de;--teal:#16685b;--paper:#fff}
*{box-sizing:border-box}body{margin:0;background:#eef2ee;color:var(--ink);font:16px/1.65 system-ui,sans-serif}
main{max-width:1100px;margin:auto;padding:44px 28px 80px}header{border-top:5px solid var(--teal);padding:28px 0}
.eyebrow{font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:var(--teal);font-weight:750}
h1{font-size:40px;line-height:1.16;letter-spacing:-.035em;margin:14px 0}h2{font-size:23px;line-height:1.3;margin:0 0 16px}
h3{font-size:17px;margin:0 0 6px}p{margin:8px 0}.muted,small{color:var(--muted)}
.intro{max-width:760px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:26px 0}
.stat,.card,section{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:22px}
.stat strong{display:block;font-size:35px;line-height:1.2}.stat span{font-size:13px;color:var(--muted)}
section{margin:20px 0}.notice{border-left:4px solid #a96b20;padding:14px 20px;background:#fff8e9;border-radius:4px}
.cards{display:grid;gap:12px}.card{padding:18px}.critical{border-left:5px solid #b34035}.warning{border-left:5px solid #b47d20}.info{border-left:5px solid #698c86}
.badge{display:inline-block;font:700 11px/1.6 system-ui;padding:4px 8px;background:#edf1f0;border-radius:4px;letter-spacing:.04em}
.NON_ESTIMABLE{background:#fce7e1;color:#913426}.ESTIMABLE{background:#e7f0ec;color:#195549}.NOT_ASSESSED{background:#fff0d5;color:#855212}
.scroll{overflow:auto}table{border-collapse:collapse;width:100%;font-size:14px;text-align:left}td,th{padding:11px 12px;border-bottom:1px solid var(--line);vertical-align:top;overflow-wrap:anywhere}th{background:#f5f7f5;font-size:12px}td.empty{background:#fff1e0;font-weight:700}
code{font:12px/1.6 ui-monospace,monospace;overflow-wrap:anywhere}pre{white-space:pre-wrap;background:#f6f8f5;padding:16px;overflow:auto;font-size:12px}details{margin-top:12px}summary{cursor:pointer;color:var(--teal)}
footer{font-size:12px;color:var(--muted);margin-top:28px}a{color:var(--teal)}
@media(max-width:600px){main{padding:22px 14px}h1{font-size:31px}.stats{gap:7px}.stat{padding:12px}.stat strong{font-size:27px}section{padding:17px}}
@media print{body{background:white}main{padding:0}section,.card{break-inside:avoid}details{display:block}}

.stat,section,.card{min-width:0}.scroll{max-width:100%}table{min-width:600px}nav{display:flex;gap:14px;flex-wrap:wrap;margin:20px 0}nav a{font-size:13px}details pre{max-height:480px}.thresholds{display:flex;gap:18px;flex-wrap:wrap}.notice{overflow-wrap:anywhere}summary:focus-visible,a:focus-visible{outline:3px solid #77ad98;outline-offset:3px}section{scroll-margin-top:20px}
@media print{details>*{display:block!important}details pre{max-height:none}.scroll{overflow:visible}table{min-width:0}}
</style></head><body><main><header><div class="eyebrow">BatchLens Bio · {{ result.tool_version }} · {{ t('Study design review', '研究设计复核') }}</div>
<h1>{{ t('Before the next biological claim.', '先看清设计，再解释差异。') }}</h1>
<p class="intro muted">{{ t('Experimental units, batch allocation and your explicit comparison. No expression data are fitted or corrected.', '核对实验单位、批次分配及你明确指定的比较。不拟合或校正表达数据。') }}</p>
{% if dataset %}<p><span class="badge">{{ t('SYNTHETIC' if dataset.kind == 'SYNTHETIC' else dataset.kind, '合成示例' if dataset.kind == 'SYNTHETIC' else dataset.kind) }}</span> {{ dataset.title }}</p>{% if dataset.limitation %}<p class="notice">{{ dataset.limitation }}</p>{% endif %}{% endif %}
<div class="stats"><div class="stat"><strong>{{ result.counts.experimental_units }}</strong><span>{{ t('Declared experimental units', '声明的生物学单位') }}</span></div><div class="stat"><strong>{{ result.counts.samples }}</strong><span>{{ t('Samples', '样本') }}</span></div><div class="stat"><strong>{{ result.counts.observations }}</strong><span>{{ t('Linked cells / spots', '关联细胞 / 空间点位') }}</span></div></div>
<div class="notice">{{ t(result.limitations, '仅依据元数据和声明的加性模型。不能证明统计功效、独立性、随机化、无未测量混杂或因果关系。') }}</div>
<nav aria-label="{{ t('Report sections','报告章节') }}"><a href="#comparisons">{{ t('Comparisons','指定比较') }}</a><a href="#findings">{{ t('Findings','复核提示') }}</a><a href="#allocation">{{ t('Batch allocation','批次分配') }}</a>{% if result.cell_support %}<a href="#cell-support">{{ t('Donor support','供体覆盖') }}</a>{% endif %}<a href="#model">{{ t('Model & scope','模型与边界') }}</a></nav></header>
<section id="comparisons"><h2>{{ t('Your requested comparisons','你指定的比较') }}</h2><div class="cards">
{% for c in result.contrasts %}<div class="card"><span class="badge {{ c.status }}">{{ t(c.status, {'ESTIMABLE':'可估计','NON_ESTIMABLE':'不可估计','NOT_ASSESSED':'未评估'}[c.status]) }}</span> <code>{{ c.status }}</code><h3>{{ c.id }}</h3><p>{{ result.declared_design.target }}: {{ c.numerator }} − {{ c.denominator }}</p>
{% if c.status == 'ESTIMABLE' %}<p class="muted">{{ t('Algebraically estimable under the declared model. This is not a biological validity or power pass.','在声明模型下代数上可估计，不代表生物学结论有效或统计功效充足。') }}</p>{% elif c.status == 'NON_ESTIMABLE' %}<p>{{ t('The requested effect cannot be uniquely separated from the other declared terms.','该效应无法与模型中其他项的影响唯一分开。') }}</p>{% else %}<p>{{ t('The sampling structure is outside the supported model. Descriptive checks still run; no contrast conclusion was made.','采样结构超出模型支持范围。仍提供描述性检查，但不对该比较作可估计性结论。') }}</p>{% endif %}</div>{% endfor %}</div></section>
<section id="findings"><h2>{{ t('Findings','复核提示') }} <span class="badge">{{ result.findings|length }}</span></h2>{% if not result.findings %}<p>{{ t('No rule triggered. This does not establish the absence of batch effects.','没有触发当前规则，不代表不存在批次效应或其他设计问题。') }}</p>{% endif %}
<div class="cards">{% for f in result.findings %}{% set copy = finding_copy(f) %}<article class="card {{ f.severity }}"><span class="badge">{{ t(f.severity|upper, {'critical':'优先复核','warning':'需要关注','info':'范围说明'}[f.severity]) }}</span> <code>{{ f.rule_id }}</code><h3>{{ copy.title }}</h3><p>{{ copy.action }}</p><details><summary>{{ t('Inspect the evidence','查看具体证据') }}</summary><pre>{{ evidence(f)|tojson(indent=2) }}</pre><p>{{ t('JSON pointers in result.json:','result.json 中的证据位置：') }}</p>{% for ref in f.evidence_refs %}<code>{{ ref }}</code><br>{% endfor %}</details></article>{% endfor %}</div></section>
<section id="allocation"><h2>{{ t('Target × batch coverage','条件 × 批次分配') }}</h2><p class="muted">{{ t('Counts use samples and distinct declared units. Empty combinations alone do not prove non-estimability.','分别统计样本数与独立声明单位数。空组合本身不等于指定比较不可估计。') }}</p><div class="scroll" tabindex="0"><table><thead><tr>{% for en,zh in [('Batch variable','批次变量'),('Batch','批次'),('Target','条件'),('Samples','样本'),('Units','单位')] %}<th>{{ t(en,zh) }}</th>{% endfor %}</tr></thead><tbody>{% for r in result.coverage %}<tr><td>{{ r.batch_variable }}</td><td>{{ r.batch_level }}</td><td>{{ r.target_level }}</td><td class="{% if r.samples == 0 %}empty{% endif %}">{{ r.samples }}</td><td>{{ r.units }}</td></tr>{% endfor %}</tbody></table></div></section>
{% if result.cell_support %}<section id="cell-support"><h2>{{ t('Cell-type donor support','细胞类型内的供体覆盖') }}</h2><p class="muted">{{ t('Cell counts are pooled within each unit, target and cell type. Thresholds prompt review; no power test or subgroup model is fitted.','在每个条件、细胞类型内合并同一供体的样本计数。阈值用于提示复核，不是功效检验；没有拟合亚组模型。') }}</p><p class="thresholds"><span>{{ t('Minimum units','最少供体数') }}: {{ result.declared_design.cell_coverage.min_units }}</span><span>{{ t('Cells per unit','每供体最少细胞数') }}: {{ result.declared_design.cell_coverage.min_cells }}</span><span>{{ t('Dominance threshold','占比阈值') }}: {{ '%g'|format(result.declared_design.cell_coverage.dominance * 100) }}%</span></p>
<div class="scroll" tabindex="0"><table><thead><tr>{% for en,zh in [('Cell type','细胞类型'),('Target','条件'),('Cells','细胞数'),('Eligible units','样本表中的供体'),('Observed units','观测供体'),('Units at threshold','达到阈值的供体'),('Largest share','最高供体占比')] %}<th>{{ t(en,zh) }}</th>{% endfor %}</tr></thead><tbody>{% for r in result.cell_support %}<tr><td>{{ r.cell_type }}</td><td>{{ r.target_level }}</td><td>{{ r.cells }}</td><td>{{ r.eligible_units }}</td><td>{{ r.observed_units }}</td><td>{{ r.supported_units }}</td><td>{{ '—' if r.largest_unit_share is none else '%.1f%%'|format(r.largest_unit_share*100) }}</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
<section><h2>{{ t('Experimental-unit structure','实验单位与重复结构') }}</h2><p>{{ t('Repeated samples and extra cells do not create additional experimental units.','重复样本和更多细胞不会增加独立实验单位。') }}</p><div class="scroll" tabindex="0"><table><tr><th>{{ t('Unit alias','单位别名') }}</th><th>{{ t('Samples','样本数') }}</th><th>{{ t('Target levels','条件') }}</th></tr>{% for u in result.units %}<tr><td>{{ u.unit_alias }}</td><td>{{ u.samples }}</td><td>{{ u.target_levels|join(', ') }}</td></tr>{% endfor %}</table></div></section>
{% if result.observation_coverage %}<section><h2>{{ t('Cell type / region summary','细胞类型 / 区域汇总') }}</h2><div class="scroll" tabindex="0"><table><tr>{% for en,zh in [('Annotation','注释类别'),('Label','标签'),('Target','条件'),('Cells/spots','细胞 / 点位'),('Samples','样本'),('Units','单位')] %}<th>{{ t(en,zh) }}</th>{% endfor %}</tr>{% for r in result.observation_coverage %}<tr><td>{{ r.annotation }}</td><td>{{ r.label }}</td><td>{{ r.target_level }}</td><td>{{ r.observations }}</td><td>{{ r.samples }}</td><td>{{ r.units }}</td></tr>{% endfor %}</table></div></section>{% endif %}
<section id="model"><h2>{{ t('Declared model & numerical evidence','声明模型与数值证据') }}</h2><p><code>Intercept + {{ result.declared_design.target }}{% for term in result.declared_design.adjust_for %} + {{ term }}{% endfor %}{% if result.declared_design.design_mode == 'paired' %} + {{ t('experimental-unit block','实验单位阻断项') }}{% endif %}</code></p>
{% set m = result.matrix_diagnostics %}{% if m %}<p>{{ t('Rank','秩') }} <strong>{{ m.rank }}</strong> / {{ m.n_columns }} {{ t('columns','列') }} · {{ m.n_rows }} {{ t('design rows','设计行') }} · {{ t('residual row degrees of freedom','剩余行自由度') }} {{ m.row_residual_df }}</p><details><summary>{{ t('Encoding and column dependencies','变量编码与列依赖') }}</summary><div class="scroll" tabindex="0"><table><tr><th>{{ t('Index','序号') }}</th><th>{{ t('Variable','变量') }}</th><th>{{ t('Level / kind','水平 / 类型') }}</th></tr>{% for col in m.columns %}<tr><td>{{ loop.index0 }}</td><td>{{ col.name }}</td><td>{{ col.level|default(col.kind) }}</td></tr>{% endfor %}</table></div><p>{{ t('Each dependency follows the column order above and satisfies Xv ≈ 0. Contrasts are checked against the row space.','每个依赖向量对应上述列顺序，并满足 Xv ≈ 0。对每个比较分别检查其是否位于行空间。') }}</p><pre>{{ m.dependencies }}</pre><p>{{ t('Rank tolerance','秩容差') }}: <code>{{ m.rank_tolerance }}</code></p>{% for c in result.contrasts %}<p>{{ c.id }}: {{ t('residual','残差') }} {{ c.row_space_residual }} / {{ t('tolerance','容差') }} {{ c.tolerance }}</p>{% endfor %}</details>{% else %}<p>{{ t('No design-matrix conclusion was produced. Independent mode requires one sample per unit; paired mode requires one sample per condition for each unit across exactly two conditions. Multiple batches within a sample are unsupported.','没有生成设计矩阵结论。独立模式要求每单位一个样本；配对模式要求恰好两个条件、每单位在每条件各一个样本。样本横跨多个批次也超出支持范围。') }}</p><details><summary>{{ t('Exact support reasons','具体范围说明（标准记录）') }}</summary><pre>{{ result.not_assessed|tojson(indent=2) }}</pre></details>{% endif %}
{% if result.input_adapter %}<p class="notice">{{ t('Quick check uses the same BatchLens contrast engine. Only declared columns were adapted.','快速检查与高级模式使用同一个比较检查引擎，仅转换已确认的列。') }} {% if result.input_adapter.cell_id_uniqueness != 'checked' %}{{ t('No cell-ID column was selected: source cell-ID uniqueness was not checked. Row identifiers were generated only for linking records.','未选择细胞 ID 列：没有检查原始细胞 ID 唯一性。生成的行编号仅用于关联记录。') }}{% endif %}</p><details><summary>{{ t('Input mapping and source fingerprint','输入映射与来源指纹') }}</summary><pre>{{ result.input_adapter|tojson(indent=2) }}</pre></details>{% endif %}
<details><summary>{{ t('Complete declared configuration','完整设计配置') }}</summary><pre>{{ result.declared_design|tojson(indent=2) }}</pre></details></section>
<footer>{{ t(result.sharing_notice,'ID 已替换为局部别名，但标签和设计取值仍可能包含可识别信息。分享前检查所有输出；报告不导出逐细胞数据。') }}<br>{{ t('A completed run is not a scientific pass.','运行完成不等于科学结论通过。') }} · result.json · tables/*.tsv · manifest.json · COMPLETE</footer></main></body></html>
