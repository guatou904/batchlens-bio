{
  "$defs": {
    "CellCoverage": {
      "additionalProperties": false,
      "description": "Opt-in descriptive thresholds, never a sample-size or power calculation.",
      "properties": {
        "min_units": {
          "default": 3,
          "maximum": 100000,
          "minimum": 2,
          "title": "Min Units",
          "type": "integer"
        },
        "min_cells": {
          "default": 20,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Min Cells",
          "type": "integer"
        },
        "dominance": {
          "default": 0.6,
          "maximum": 1.0,
          "minimum": 0.5,
          "title": "Dominance",
          "type": "number"
        }
      },
      "title": "CellCoverage",
      "type": "object"
    },
    "Contrast": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "numerator": {
          "title": "Numerator",
          "type": "string"
        },
        "denominator": {
          "title": "Denominator",
          "type": "string"
        }
      },
      "required": [
        "id",
        "numerator",
        "denominator"
      ],
      "title": "Contrast",
      "type": "object"
    },
    "Variable": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "target",
            "batch",
            "covariate"
          ],
          "title": "Role",
          "type": "string"
        },
        "type": {
          "enum": [
            "categorical",
            "numeric"
          ],
          "title": "Type",
          "type": "string"
        },
        "levels": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Levels"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        }
      },
      "required": [
        "role",
        "type"
      ],
      "title": "Variable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "design_mode": {
      "enum": [
        "independent",
        "paired"
      ],
      "title": "Design Mode",
      "type": "string"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "unit_id": {
      "title": "Unit Id",
      "type": "string"
    },
    "variables": {
      "additionalProperties": {
        "$ref": "#/$defs/Variable"
      },
      "title": "Variables",
      "type": "object"
    },
    "target": {
      "title": "Target",
      "type": "string"
    },
    "adjust_for": {
      "items": {
        "type": "string"
      },
      "title": "Adjust For",
      "type": "array"
    },
    "contrasts": {
      "items": {
        "$ref": "#/$defs/Contrast"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Contrasts",
      "type": "array"
    },
    "cell_coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/CellCoverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "design_mode",
    "sample_id",
    "unit_id",
    "variables",
    "target",
    "adjust_for",
    "contrasts"
  ],
  "title": "StudySpec",
  "type": "object"
}
